# kcgl 部署环境变量样板——复制为 .env 后填写（.env 权限 600，绝不入库）
# 生成强随机密码：openssl rand -base64 24

# ---------- 数据库（三项均必填） ----------
# MySQL root（备份/巡检/灾难恢复用；仅本机 docker compose exec 消费，不对外）
MYSQL_ROOT_PASSWORD=change-me-root
# 业务账号 kcgl（最小 GRANT：16 业务表四权 + 两流水表只增 + flyway history 只读）
DB_PASSWORD=change-me-app
# 迁移账号 kcgl_migrate（库全权，仅 migrate 一次性容器使用）
DB_MIGRATE_PASSWORD=change-me-migrate

# ---------- 版本 ----------
# 镜像 tag；升级=改此值后 docker compose up -d（回滚同法，docs/01 R10）。
# 此值同时透传进 app 容器：系统状况页「アプリバージョン」显示它＝甲方核对升级是否生效的判据。
# 仓库内此处的 latest 供 CI/测试环境（ghcr 默认 tag）；**交付包里由 pack-release.sh
# 改写为本次打包的确切版本**，甲方通常无需改动这一行。
KCGL_VERSION=latest

# ---------- 资源 ----------
# MySQL buffer pool（共享测试机压到 256M——整机 3.3G/可用 1.0G/无 swap，勘察 D-077；
# 独立生产主机按规格放大至 1G+）
KCGL_INNODB_BUFFER=256M

# ---------- 对外暴露 ----------
# 非标端口规避大陆未备案 80/443 拦截（D-077）；备案域名就绪后切 443（见 deployment.md）
WEB_PORT=8082

# ---------- 应用 ----------
# HTTPS 环境必须 true（Secure cookie；HTTP 测试环境 false）
COOKIE_SECURE=false
# 实际访问源，逗号分隔——同源部署填唯一入口，如：
#   http://49.232.49.175:8082   或   https://kcgl.example.com
# 留空或填错 = 带 Origin 的请求（登录/全部写操作）被 403 拒绝
KCGL_ALLOWED_ORIGINS=http://change-me:8082

# ---------- 备份（backup.sh / kcgl-doctor.sh / app 显示共用；详见各脚本头部注释） ----------
# 备份根目录（宿主路径；需可容纳 DB dump + 图片硬链快照，磁盘规划见 deployment.md）。
# app 容器将此目录 ro 挂载（/data/backup）读取 backup-status.json——系统状况页
# 「直近バックアップ成功時刻」卡的数据源（M7 增量）；备份写入仅宿主 backup.sh
KCGL_BACKUP_DIR=/opt/kcgl/backup
# 备份/恢复使用的 MySQL 管理口令。**留空即可**（backup.sh/restore.sh 自动沿用上面的
# MYSQL_ROOT_PASSWORD）。仅当甲方把备份改用另一个管理账号时才填，且必须填**该账号的真实
# 口令**——曾经这里放样板值 change-me-root，甲方照抄却不改，于是每晚备份全部
# 「Access denied」静默失败、直到磁盘/新鲜度告警才发现（D-090 干净主机演练实测）。
# 空值与样板值都不会被当成口令：填 change-me-* 会被 backup.sh 直接拒绝并写失败状态。
MYSQL_ROOT_PASSWORD_BACKUP=
